{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://makemelearn.fr/schema/universe.schema.json",
  "title": "Univers MakeMeLearn (universe.json, format v1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "id", "slug", "titre", "statut", "chapitres"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "content_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z]{2,6}$", "description": "Préfixe des identifiants (compétences, leçons, items)" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "titre": { "type": "string", "minLength": 3, "maxLength": 120 },
    "accroche": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "locale": { "const": "fr" },
    "statut": { "enum": ["brouillon", "relecture", "publie"] },
    "ordre": { "type": "integer", "minimum": 0 },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "couleur": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "icone": { "type": "string", "maxLength": 40 }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 70 },
        "meta_description": { "type": "string", "maxLength": 160 },
        "slug_url": { "type": "string", "pattern": "^/univers/[a-z0-9-]+$" },
        "mots_cles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promesse": { "type": "string", "maxLength": 300 },
        "public": { "type": "string", "maxLength": 200 },
        "niveau": { "type": "string", "maxLength": 40 }
      }
    },
    "lore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accroche": { "type": "string", "maxLength": 300 },
        "monde": { "type": "string", "maxLength": 1200 },
        "ton": { "type": "string", "maxLength": 200 }
      }
    },
    "personnages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nom", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nom": { "type": "string", "maxLength": 80 },
          "role": { "type": "string", "maxLength": 60 },
          "bio": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "chapitres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "titre"],
        "properties": {
          "id": { "type": "string", "pattern": "^c\\d{2}$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "titre": { "type": "string", "maxLength": 120 },
          "resume": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "licence_contenu": { "type": "string", "maxLength": 80 },
        "date_revue": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string", "maxLength": 400 }
      }
    }
  }
}
