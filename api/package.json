{
  "name": "makemelearn-api",
  "version": "1.0.0",
  "description": "Backend API for MakeMeLearn landing page - handles contact forms and newsletter signups",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:safe": "node ../scripts/check-safe.mjs",
    "content:validate": "node ../scripts/validate-content.mjs",
    "content:sync": "node ../scripts/sync-content.mjs"
  },
  "keywords": [
    "express",
    "api",
    "contact-form",
    "newsletter",
    "email",
    "makemelearn"
  ],
  "author": "MakeMeLearn Team",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.11.3",
    "ts-fsrs": "^5.4.2",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pg-mem": "^3.0.14",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creach-t/makemelearn-landing.git",
    "directory": "api"
  },
  "bugs": {
    "url": "https://github.com/creach-t/makemelearn-landing/issues"
  },
  "homepage": "https://creach-t.github.io/makemelearn-landing/",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/test/setup-env.js"
    ],
    "testTimeout": 20000
  }
}
